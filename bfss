class Solution {
  public:
    vector<int> bfs(vector<vector<int>> &adj) {
        // code here
        vector<int> vis(adj.size(),0);
        vector<int> bfsArray;
        queue<int> q;
        q.push(0);
        vis[0]=1;
        while (!q.empty()){
            int node=q.front();
            bfsArray.push_back(node);
            q.pop();
            for (auto it : adj[node]){
                if (!vis[it]){
                    vis[it]=1;
                    q.push(it);
                }
            }
        }
        return bfsArray;
    }
};
